# Copy to .env.platform-staging.local (ignored by Git).
# Use staging values only. Keep quoted values literal; never paste secrets in chat.
PLATFORM_STAGING_CONFIRM=staging
PLATFORM_STAGING_ALLOW_REMOTE=true
PLATFORM_STAGING_DATABASE_PROVIDER=supabase
PLATFORM_STAGING_RESOURCE_NAME="Terraqo Platform Staging"
PLATFORM_STAGING_SUPABASE_PROJECT_REF=mghdpciewbsowjrjwmwk
PLATFORM_STAGING_DATABASE_ROLE=terraqo_staging_runtime
B5_GATE_EXPECTED_DATABASE=postgres
# Exact runtime-role URL for this Supabase project, including schema=icc.
B5_GATE_DATABASE_URL=""
NEXT_PUBLIC_SITE_URL=https://terraqo-platform-staging.netlify.app
NEXT_PUBLIC_PORTAL_URL=https://terraqo-platform-staging.netlify.app
NEXT_PUBLIC_ADMIN_URL=https://terraqo-platform-staging.netlify.app
NEXT_PUBLIC_API_URL=https://terraqo-platform-staging.netlify.app
AUTH_URL=https://terraqo-platform-staging.netlify.app
# Existing independent staging secrets; Netlify masked values are not credentials.
AUTH_SECRET=""
EVIDENCE_ANALYSIS_DISPATCH_SECRET=""
TERRAQO_STAGING_DOCUMENT_CLEANUP_SECRET=""
TERRAQO_STAGING_BILLING_RECONCILE_SECRET=""
TERRAQO_OAUTH_ENABLED=false
TERRAQO_TRANSACTIONAL_EMAIL_ENABLED=false
# These must match the actual deployment. This template enables nothing remotely.
PLATFORM_STAGING_ENABLED_FLAGS=TERRAQO_WORKLOG_FTS_V1,TERRAQO_WORK_CASES_V1,TERRAQO_SCOPED_SHARING_V1,TERRAQO_SCOPED_ENDORSEMENTS_V1,TERRAQO_DISCOVERY_NEEDS_V1,TERRAQO_CONTEXTUAL_MESSAGING_V1,TERRAQO_COLLABORATION_V1,TERRAQO_CLOSURE_V1
PLATFORM_STAGING_ACTIVATION_CONFIRM=cohort
TERRAQO_WORKLOG_FTS_V1=true
TERRAQO_WORK_CASES_V1=true
TERRAQO_SCOPED_SHARING_V1=true
TERRAQO_SCOPED_ENDORSEMENTS_V1=true
TERRAQO_DISCOVERY_NEEDS_V1=true
TERRAQO_CONTEXTUAL_MESSAGING_V1=true
TERRAQO_COLLABORATION_V1=true
TERRAQO_CLOSURE_V1=true
TERRAQO_EVIDENCE_ANALYSIS_V1=false
TERRAQO_EVIDENCE_ANALYSIS_PROVIDER=off
PLATFORM_STAGING_PROVIDER_CONFIRM=""
PLATFORM_STAGING_PILOT_WORKSPACE_IDS=""
TERRAQO_B5_PILOT_WORKSPACE_IDS=""
# Each test retains its own exact fixture consent and flag/cohort prerequisites.
TERRAQO_STAGING_MUTATING_TESTS=""
TERRAQO_STAGING_B5_PROVIDER_TESTS=""
# Only configure a provider during its authorized synthetic staging gate.
GROQ_API_KEY=""
GROQ_EVIDENCE_ANALYSIS_MODEL=openai/gpt-oss-20b
