DATABASE_URL="postgresql://postgres:postgres@localhost:5432/icc_geo_commerce?schema=public"
PLATFORM_STAGING_CONFIRM=""
PLATFORM_STAGING_ALLOW_REMOTE=false
# Set to "supabase" only for a dedicated Supabase staging project. Supabase's
# managed database is named "postgres", so isolation is verified through the
# exact project ref and the staging resource name rather than the DB name.
PLATFORM_STAGING_DATABASE_PROVIDER="postgresql"
PLATFORM_STAGING_RESOURCE_NAME=""
PLATFORM_STAGING_SUPABASE_PROJECT_REF=""
PLATFORM_STAGING_DATABASE_ROLE=""
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional OAuth sign-in. Buttons remain visible but report unavailable until
# the matching provider is configured. Never expose these secrets to the client.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
# Explicitly set false in isolated staging environments that inherit account
# variables. The server and login UI then omit every OAuth provider.
TERRAQO_OAUTH_ENABLED=true

# Culqi: configure once the merchant account supports subscriptions.
# Empty by default; configuring these values alone never enables billing.
CULQI_MODE="test"
CULQI_PUBLIC_KEY=""
CULQI_SECRET_KEY=""
# Provider plan IDs are versioned in TerraqoBillingPlan, not copied into environment variables.
BILLING_LIVE_ENABLED="false"
# At least 32 random characters; only the server and scheduled function receive this value.
BILLING_RECONCILE_SECRET=""
NEXT_PUBLIC_WHATSAPP_NUMBER="51999999999"
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
TERRAQO_MEET_DOMAIN="meet.jit.si"

# Transactional email. Verify terraqoglobal.com in Resend before enabling production.
RESEND_API_KEY=""
TERRAQO_EMAIL_FROM="Terraqo <noreply@terraqoglobal.com>"
# Keep false in staging until synthetic-recipient delivery is explicitly tested.
TERRAQO_TRANSACTIONAL_EMAIL_ENABLED=true

# Optional AI provider for Terraqo profile summaries.
# Recommended for local/open-source deployments: run Ollama on a reachable host.
# In production, localhost only works if Ollama runs inside the same server/container.
AI_PROFILE_SUMMARY_PROVIDER="ollama" # ollama | openai | none
AI_PROFILE_SUMMARY_TIMEOUT_MS="12000"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.1:8b"
OLLAMA_PROFILE_SUMMARY_MODEL="llama3.1:8b"
TERRAQO_DOCUMENT_AI_URL="http://127.0.0.1:8080"
TERRAQO_DOCUMENT_AI_TOKEN=""
TERRAQO_DOCUMENT_AI_TIMEOUT_MS="720000"
CV_IMPORT_DISPATCH_SECRET=""
OLLAMA_CV_MODEL="qwen2.5:7b-instruct"
OPENAI_PROFILE_SUMMARY_MODEL="gpt-4.1-mini"

# Provisioning only. Do not commit real passwords.
TERRAQO_ADMIN_EMAIL="admin@terraqoglobal.com"
TERRAQO_ADMIN_PASSWORD=""
ICC_ADMIN_EMAIL="admin@icctopografia.com"
ICC_ADMIN_PASSWORD=""
ICC_WORKSPACE_SLUG="icc-topografia"
AI_PROVIDER="groq"
GROQ_API_KEY=""
GROQ_TEXT_MODEL="openai/gpt-oss-20b"
OPENAI_API_KEY=""
OPENAI_TEXT_MODEL="gpt-5.4-mini"

#CULQI
email_culqi_pruebas = "review@culqi.com"

# Isolated CV control: enable only after authenticated browser release checks.
TERRAQO_WEB_CV_PUBLICATION_ENABLED=false

# B1 evidence archive rollout. Keep disabled until the generated tsvector
# migration and its GIN index are applied and measured in staging.
TERRAQO_WORKLOG_FTS_V1=false

# B2 explicit work grouping. Enable only after the WorkCase migration is applied.
TERRAQO_WORK_CASES_V1=false

# B3 Trust + Sharing. Keep both disabled until the B3 migration and
# actor x tenant x resource matrix pass in staging.
TERRAQO_SCOPED_SHARING_V1=false
TERRAQO_SCOPED_ENDORSEMENTS_V1=false
TERRAQO_DISCOVERY_NEEDS_V1=false
TERRAQO_CONTEXTUAL_MESSAGING_V1=false
TERRAQO_COLLABORATION_V1=false
TERRAQO_CLOSURE_V1=false

# T18 private evidence analysis. Keep disabled until its migration, permission
# matrix and an isolated provider have passed staging. "off" preserves the
# complete manual evaluation flow without making external requests.
TERRAQO_EVIDENCE_ANALYSIS_V1=false
TERRAQO_B5_PILOT_WORKSPACE_IDS="" # CSV de IDs o * solo en un piloto aprobado
TERRAQO_EMPLOYER_NEEDS_MONTHLY_LIMIT="25" # tope operativo del piloto; no es precio
TERRAQO_EVIDENCE_ANALYSIS_MONTHLY_LIMIT="100" # adicional al límite diario por actor
TERRAQO_EVIDENCE_ANALYSIS_PROVIDER="off" # off | ollama | groq | openai
TERRAQO_EVIDENCE_ANALYSIS_TIMEOUT_MS="45000"
TERRAQO_EVIDENCE_ANALYSIS_MAX_INPUT_CHARS="48000"
TERRAQO_EVIDENCE_ANALYSIS_MAX_OUTPUT_TOKENS="1400"
TERRAQO_EVIDENCE_ANALYSIS_MAX_ATTEMPTS="2"
TERRAQO_EVIDENCE_ANALYSIS_DAILY_LIMIT="20"
OLLAMA_EVIDENCE_ANALYSIS_MODEL="qwen2.5:7b-instruct"
GROQ_EVIDENCE_ANALYSIS_MODEL="openai/gpt-oss-20b"
OPENAI_EVIDENCE_ANALYSIS_MODEL="gpt-5.4-mini"
# Optional exact provider rates and hard cap, expressed in micro-units of the
# billing currency. Leave all three empty when costs are not contractually set.
TERRAQO_EVIDENCE_INPUT_COST_PER_MILLION_MICROS=""
TERRAQO_EVIDENCE_OUTPUT_COST_PER_MILLION_MICROS=""
TERRAQO_EVIDENCE_MAX_JOB_COST_MICROS=""
# Generate independently; only Netlify and the server may receive this value.
EVIDENCE_ANALYSIS_DISPATCH_SECRET=""

# Mutating isolation gates. Use only local disposable database copies; the
# scripts reject remote hosts, ambiguous names and mismatched confirmations.
ISOLATION_TEST_DATABASE_URL=""
ISOLATION_TEST_EXPECTED_DATABASE=""
WORKLOG_ISOLATION_DATABASE_URL=""
WORKLOG_ISOLATION_EXPECTED_DATABASE=""
TERRAQO_DEPLOYED_PORTAL_TESTS=""
