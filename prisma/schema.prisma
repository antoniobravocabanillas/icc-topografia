generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  TECHNICIAN
  SALES
  EDITOR
  ADMIN
  SUPER_ADMIN
  COMMERCIAL_ADMIN
  SURVEYOR
  ENGINEER
  ARCHITECT
  SUPPORT
}

enum OrderStatus {
  PENDING
  QUOTED
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  EVALUATION
  QUOTED
  NEGOTIATION
  WON
  LOST
  REQUIRES_TECH_SUPPORT
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum OpportunityStatus {
  OPEN
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  WON
  LOST
  ARCHIVED
}

enum SaleStatus {
  PENDING
  CONFIRMED
  INVOICED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum CommissionType {
  SALE_PERCENTAGE
  MARGIN_PERCENTAGE
  FIXED_AMOUNT
  CATEGORY_PERCENTAGE
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  FINISHED
  PUBLISHED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum ProjectRole {
  SURVEYOR
  ENGINEER
  ARCHITECT
  SELLER
  SUPPORT
  MANAGER
}

enum TechnicalAvailability {
  AVAILABLE
  FIELD
  BUSY
  OFFLINE
}

enum TicketCategory {
  EQUIPMENT
  SERVICE
  CALIBRATION
  REPAIR
  WARRANTY
  TECHNICAL_QUERY
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  REVIEWING
  WAITING_CUSTOMER
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum BotProvider {
  LOCAL
  OPENROUTER
  GEMINI
  GROQ
  HUGGINGFACE
  OLLAMA
}

enum BotQuestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  LEAD
  QUOTE
  TICKET
  CHAT
  PROJECT
  COMMISSION
  FAQ
  SYSTEM
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  STATUS_CHANGED
  CONVERTED
  ASSIGNED
  COMMENTED
  UPLOADED
  APPROVED
  REJECTED
}

enum ChatStatus {
  WAITING
  ACTIVE
  CLOSED
}

enum StaffDepartment {
  SALES
  TECHNICAL_SUPPORT
  FIELD_ENGINEERING
  RENTAL_SERVICE
  ADMINISTRATION
}

enum TerraqoWorkspaceType {
  CLIENT_COMPANY
  INTERNAL_UNIT
  PRODUCT_ADMIN
}

enum TerraqoPlanTier {
  FREE
  BASIC
  PROFESSIONAL
  PREMIUM
  ENTERPRISE
}

enum TerraqoSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum TerraqoModuleCode {
  CRM
  PROJECTS
  PUBLIC_WEBSITE
  TECHNICAL_STORE
  CUSTOMER_CHAT
  PROFESSIONAL_NETWORK
  LIVE_CV
  JOB_MARKETPLACE
  FORUMS
  PROFESSIONAL_MESSAGING
  TERRAQO_MEET
  COLLABORATION_TEAMS
  ANALYTICS
  AUTOMATIONS
  DOCUMENTS
}

enum TerraqoMeetingStatus {
  LIVE
  ENDED
  CANCELLED
}

enum TerraqoMeetingProvider {
  JITSI
  CUSTOM_JITSI
}

enum TerraqoConversationType {
  DIRECT
  COMPANY
  PROJECT
  GROUP
}

enum TerraqoConversationParticipantRole {
  OWNER
  MODERATOR
  MEMBER
}

enum TerraqoTeamStatus {
  ACTIVE
  ARCHIVED
}

enum TerraqoTeamRole {
  OWNER
  LEAD
  MEMBER
}

enum TerraqoTeamMemberStatus {
  INVITED
  ACTIVE
  DECLINED
  REMOVED
}

enum TerraqoMemberRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
  CLIENT
  PROFESSIONAL
}

enum TerraqoProfessionalStatus {
  AVAILABLE
  WORKING
  OPEN_TO_PROJECTS
  NOT_AVAILABLE
}

enum TerraqoVisibility {
  PUBLIC
  COMMUNITY
  WORKSPACE
  PRIVATE
}

enum TerraqoWorklogType {
  FIELD_UPDATE
  DELIVERABLE
  PROBLEM_SOLVED
  LEARNING
  MILESTONE
}

enum TerraqoEvidenceStatus {
  DECLARED
  LINKED
  CONFIRMED
  VERIFIED
}

enum TerraqoWorklogValidationStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum TerraqoWebAuthnPurpose {
  REGISTRATION
  WORKLOG_VALIDATION
  ATTENDANCE
}

enum TerraqoAttendanceType {
  CHECK_IN
  CHECK_OUT
}

enum TerraqoAttendanceStatus {
  ACCEPTED
  OUTSIDE_GEOFENCE
  LOCATION_UNAVAILABLE
  REJECTED
}

enum TerraqoReactionType {
  USEFUL
  INSIGHTFUL
  RESPECT
}

enum TerraqoApplicationStatus {
  DRAFT
  SUBMITTED
  REVIEWING
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum TerraqoIdentityVerificationStatus {
  PENDING_DOCUMENTS
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum TerraqoProfessionalDocumentType {
  CV
  DNI_FRONT
  DNI_BACK
  CERTIFICATE
  PROFESSIONAL_LICENSE
  CRIMINAL_RECORD
  MEDICAL_EXAM
  BANK_CERTIFICATE
  OTHER
}

enum TerraqoDocumentReviewStatus {
  SUBMITTED
  VERIFIED
  REJECTED
}

enum TerraqoNoteKind {
  SIMPLE
  SECURE
}

enum TerraqoFileVisibility {
  PRIVATE
  WORKSPACE
}

enum TerraqoFileCategory {
  PLAN
  REPORT
  SPREADSHEET
  PRESENTATION
  IMAGE
  SOURCE_FILE
  CONTRACT
  TEMPLATE
  OTHER
}

model User {
  id                          String                           @id @default(cuid())
  name                        String?
  email                       String                           @unique
  emailVerified               DateTime?
  image                       String?
  passwordHash                String?
  role                        Role                             @default(CUSTOMER)
  accounts                    Account[]
  sessions                    Session[]
  orders                      Order[]
  addresses                   Address[]
  favorites                   Favorite[]
  assignedChats               ChatConversation[]
  ticketMessages              TicketMessage[]
  internalMessages            InternalChatMessage[]
  notifications               Notification[]
  activityLogs                ActivityLog[]
  staffProfiles               StaffProfile[]
  clientProfiles              Client[]
  clientAccounts              ClientAccount[]
  terraqoMemberships          TerraqoWorkspaceMember[]
  ownedTerraqoWorkspaces      TerraqoWorkspace[]               @relation("TerraqoWorkspaceOwner")
  terraqoProfessionalProfile  TerraqoProfessionalProfile?
  terraqoForumPosts           TerraqoForumPost[]
  terraqoForumReplies         TerraqoForumReply[]
  terraqoApplications         TerraqoProjectApplication[]
  terraqoWorklogs             TerraqoWorklogEntry[]            @relation("TerraqoWorklogAuthor")
  terraqoWorklogComments      TerraqoWorklogComment[]
  terraqoWorklogReactions     TerraqoWorklogReaction[]
  terraqoConversationsCreated TerraqoConversation[]            @relation("TerraqoConversationCreator")
  terraqoConversationMembers  TerraqoConversationParticipant[]
  terraqoDirectMessages       TerraqoDirectMessage[]           @relation("TerraqoDirectMessageSender")
  terraqoMeetingsCreated      TerraqoMeeting[]                 @relation("TerraqoMeetingCreator")
  terraqoMeetingParticipants  TerraqoMeetingParticipant[]
  terraqoTeamsOwned           TerraqoTeam[]                    @relation("TerraqoTeamOwner")
  terraqoTeamMemberships      TerraqoTeamMember[]              @relation("TerraqoTeamMemberUser")
  terraqoTeamInvitationsSent  TerraqoTeamMember[]              @relation("TerraqoTeamMemberInviter")
  terraqoPrivateNotes         TerraqoPrivateNote[]
  terraqoWorkspaceFiles       TerraqoWorkspaceFile[]
  terraqoPasskeys             TerraqoWebAuthnCredential[]
  terraqoWebAuthnChallenges   TerraqoWebAuthnChallenge[]
  terraqoValidationRequests   TerraqoWorklogValidation[]       @relation("TerraqoValidationRequester")
  terraqoValidationsAssigned  TerraqoWorklogValidation[]       @relation("TerraqoValidationSupervisor")
  terraqoAttendanceEvents     TerraqoAttendanceEvent[]
  createdAt                   DateTime                         @default(now())
  updatedAt                   DateTime                         @updatedAt
}

model Company {
  id                       String                           @id @default(cuid())
  legalName                String
  tradeName                String?
  document                 String?
  email                    String?
  phone                    String?
  address                  String?
  city                     String?
  industry                 String?
  status                   String                           @default("prospecto")
  contacts                 Contact[]
  accounts                 ClientAccount[]
  clients                  Client[]
  leads                    Lead[]
  opportunities            Opportunity[]
  quotes                   Quote[]
  sales                    Sale[]
  projects                 Project[]
  tickets                  Ticket[]
  documents                Document[]
  activities               ActivityLog[]
  terraqoWorkspaces        TerraqoWorkspace[]
  professionalAffiliations TerraqoProfessionalAffiliation[]
  terraqoWorkspaceId       String
  terraqoWorkspace         TerraqoWorkspace                 @relation("TerraqoWorkspaceCompanies", fields: [terraqoWorkspaceId], references: [id], onDelete: Restrict)
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt
  deletedAt                DateTime?

  @@index([document])
  @@index([status])
  @@index([terraqoWorkspaceId])
  @@index([deletedAt])
}

model Contact {
  id                 String           @id @default(cuid())
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name               String
  roleTitle          String?
  email              String?
  phone              String?
  whatsapp           String?
  isPrimary          Boolean          @default(false)
  clientAccounts     ClientAccount[]
  leads              Lead[]
  opportunities      Opportunity[]
  quotes             Quote[]
  sales              Sale[]
  tickets            Ticket[]
  documents          Document[]
  activities         ActivityLog[]
  terraqoWorkspaceId String
  terraqoWorkspace   TerraqoWorkspace @relation(fields: [terraqoWorkspaceId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  @@unique([companyId, email])
  @@index([email])
  @@index([terraqoWorkspaceId])
  @@index([deletedAt])
}

model ClientAccount {
  id                 String           @id @default(cuid())
  userId             String?
  user               User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId          String?
  contact            Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  clientId           String?          @unique
  client             Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  status             String           @default("invited")
  terraqoWorkspaceId String
  terraqoWorkspace   TerraqoWorkspace @relation(fields: [terraqoWorkspaceId], references: [id], onDelete: Restrict)
  invitedAt          DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  @@unique([terraqoWorkspaceId, userId])
  @@index([companyId])
  @@index([contactId])
  @@index([status])
  @@index([terraqoWorkspaceId])
}

model Client {
  id                 String           @id @default(cuid())
  userId             String?
  user               User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId          String?
  companyRef         Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  account            ClientAccount?
  name               String
  company            String?
  document           String?
  email              String
  phone              String?
  address            String?
  contactName        String?
  status             String           @default("prospecto")
  leads              Lead[]
  quotes             Quote[]
  projects           Project[]
  tickets            Ticket[]
  documents          ClientDocument[]
  sales              Sale[]
  terraqoWorkspaceId String
  terraqoWorkspace   TerraqoWorkspace @relation(fields: [terraqoWorkspaceId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  @@unique([terraqoWorkspaceId, userId])
  @@unique([terraqoWorkspaceId, email])
  @@index([email])
  @@index([status])
  @@index([companyId])
  @@index([terraqoWorkspaceId])
  @@index([deletedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id                 String           @id @default(cuid())
  terraqoWorkspaceId String
  terraqoWorkspace   TerraqoWorkspace @relation(fields: [terraqoWorkspaceId], references: [id], onDelete: Restrict)
  name               String
  slug               String
  description        String?
  parentId           String?
  parent             Category?        @relation("CategoryTree", fields: [parentId], references: [id])
  children           Category[]       @relation("CategoryTree")
  products           Product[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([terraqoWorkspaceId, slug])
  @@index([terraqoWorkspaceId])
}

model Product {
  id                 String           @id @default(cuid())
  name               String
  slug               String
  sku                String
  brand              String
  model              String?
  summary            String
  description        String
  price              Decimal?
  stock              Int              @default(0)
  currency           String           @default("USD")
  requiresQuote      Boolean          @default(false)
  availability       String
  badge              String?
  images             String[]
  mainImage          String?
  manualUrl          String?
  rentalPrice        Decimal?
  commercialMode     String           @default("venta")
  location           String?
  tags               String[]
  isFeatured         Boolean          @default(false)
  isVisible          Boolean          @default(true)
  technicalSheet     String?
  specifications     Json
  isActive           Boolean          @default(true)
  categoryId         String
  category           Category         @relation(fields: [categoryId], references: [id])
  terraqoWorkspaceId String
  terraqoWorkspace   TerraqoWorkspace @relation(fields: [terraqoWorkspaceId], references: [id], onDelete: Restrict)
  variants           ProductVariant[]
  orderItems         OrderItem[]
  quoteItems         QuoteItem[]
  favorites          Favorite[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([terraqoWorkspaceId, slug])
  @@unique([terraqoWorkspaceId, sku])
  @@index([categoryId])
  @@index([brand])
  @@index([requiresQuote])
  @@index([stock])
  @@index([isActive])
  @@index([terraqoWorkspaceId])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  name      String
  sku       String
  price     Decimal?
  stock     Int      @default(0)
  options   Json
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sku])
  @@index([productId])
}

model Order {
  id                 String           @id @default(cuid())
  userId             String?
  user               User?            @relation(fields: [userId], references: [id])
  customerName       String
  customerEmail      String
  customerPhone      String?
  status             OrderStatus      @default(PENDING)
  total              Decimal
  currency           String           @default("USD")
  notes              String?
  terraqoWorkspaceId String
  terraqoWorkspace   TerraqoWorkspace @relation(fields: [terraqoWorkspaceId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  addressId          String?
  address            Address?         @relation(fields: [addressId], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([customerEmail])
  @@index([terraqoWorkspaceId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal
  subtotal  Decimal
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Address {
  id         String  @id @default(cuid())
  userId     String?
  user       User?   @relation(fields: [userId], references: [id])
  label      String?
  line1      String
  line2      String?
  city       String
  region     String?
  country    String  @default("PE")
  postalCode String?
  orders     Order[]
}

model Favorite {
  id        String  @id @default(cuid())
  userId    String
  productId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Service {
  id                 String           @id @default(cuid())
  title              String
  slug               String
  category           String?
  categoryId         String?
  subcategoryId      String?
  categoryRef        ServiceCategory? @relation("ServiceCategoryPrimary", fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryRef     ServiceCategory? @relation("ServiceCategorySecondary", fields: [subcategoryId], references: [id], onDelete: SetNull)
  isFeatured         Boolean          @default(false)
  status             String           @default("ACTIVE")
  icon               String?
  cover              String?
  gallery            String[]         @default([])
  video              String?
  headline           String?
  summary            String
  benefits           String[]         @default([])
  applications       String[]         @default([])
  deliverables       String[]         @default([])
  technologies       String[]         @default([])
  precision          String?
  formats            String[]         @default([])
  compatibility      String[]         @default([])
  seoTitle           String?
  metaDescription    String?
  ogImage            String?
  relatedProjects    String[]         @default([])
  successCases       String[]         @default([])
  relatedServices    String[]         @default([])
  sectorSlugs        String[]         @default([])
  content            Json
  terraqoWorkspaceId String
  terraqoWorkspace   TerraqoWorkspace @relation(fields: [terraqoWorkspaceId], references: [id], onDelete: Restrict)
  isPublished        Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([terraqoWorkspaceId, slug])
  @@index([isPublished, isFeatured])
  @@index([category])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([status])
  @@index([terraqoWorkspaceId])
}

model Sector {
  id                 String           @id @default(cuid())
  name               String
  slug               String
  description        String
  icon               String?
  image              String?
  position           Int              @default(0)
  active             Boolean          @default(true)
  seoTitle           String?
  metaDescription    String?
  terraqoWorkspaceId String
  terraqoWorkspace   TerraqoWorkspace @relation(fields: [terraqoWorkspaceId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([terraqoWorkspaceId, slug])
  @@index([active])
  @@index([position])
  @@index([terraqoWorkspaceId])
}

model ServiceCategory {
  id                  String            @id @default(cuid())
  name                String
  slug                String
  description         String?
  icon                String?
  seoTitle            String?
  metaDescription     String?
  position            Int               @default(0)
  active              Boolean           @default(true)
  parentId            String?
  parent              ServiceCategory?  @relation("ServiceCategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children            ServiceCategory[] @relation("ServiceCategoryTree")
  services            Service[]         @relation("ServiceCategoryPrimary")
  subcategoryServices Service[]         @relation("ServiceCategorySecondary")
  terraqoWorkspaceId  String
  terraqoWorkspace    TerraqoWorkspace  @relation(fields: [terraqoWorkspaceId], references: [id], onDelete: Restrict)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([terraqoWorkspaceId, slug])
  @@index([parentId])
  @@index([active])
  @@index([position])
  @@index([terraqoWorkspaceId])
}

model CmsPage {
  id                 String           @id @default(cuid())
  title              String
  slug               String
  metaTitle          String?
  metaDesc           String?
  content            Json
  isPublished        Boolean          @default(true)
  terraqoWorkspaceId String
  terraqoWorkspace   TerraqoWorkspace @relation(fields: [terraqoWorkspaceId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([terraqoWorkspaceId, slug])
  @@index([terraqoWorkspaceId])
}

model Banner {
  id                 String           @id @default(cuid())
  title              String
  subtitle           String?
  ctaLabel           String?
  ctaHref            String?
  image              String?
  placement          String
  active             Boolean          @default(true)
  terraqoWorkspaceId String
  terraqoWorkspace   TerraqoWorkspace @relation(fields: [terraqoWorkspaceId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())

  @@index([terraqoWorkspaceId])
}

model Testimonial {
  id                 String           @id @default(cuid())
  quote              String
  author             String
  company            String?
  role               String?
  active             Boolean          @default(true)
  terraqoWorkspaceId String
  terraqoWorkspace   TerraqoWorkspace @relation(fields: [terraqoWorkspaceId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())

  @@index([terraqoWorkspaceId])
}

model ClientLogo {
  id                 String           @id @default(cuid())
  name               String
  logoUrl            String
  website            String?
  sector             String?
  position           Int              @default(0)
  active             Boolean          @default(true)
  terraqoWorkspaceId String
  terraqoWorkspace   TerraqoWorkspace @relation(fields: [terraqoWorkspaceId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([active, position])
  @@index([terraqoWorkspaceId])
}

model Faq {
  id                 String           @id @default(cuid())
  question           String
  answer             String
  category           String?
  origin             String           @default("manual")
  approved           Boolean          @default(true)
  usageCount         Int              @default(0)
  position           Int              @default(0)
  active             Boolean          @default(true)
  terraqoWorkspaceId String
  terraqoWorkspace   TerraqoWorkspace @relation(fields: [terraqoWorkspaceId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())

  @@index([active, approved, position])
  @@index([terraqoWorkspaceId])
}

model BlogPost {
  id                 String           @id @default(cuid())
  title              String
  slug               String
  excerpt            String
  content            Json
  author             String?
  category           String?
  metaTitle          String?
  metaDesc           String?
  publishedAt        DateTime?
