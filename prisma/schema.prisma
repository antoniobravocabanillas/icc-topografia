  author    User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  @@index([postId, createdAt])
  @@index([authorId])
}
