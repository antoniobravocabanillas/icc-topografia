TERRAQO_DOCUMENT_AI_TOKEN=replace-with-at-least-32-random-bytes
OLLAMA_CV_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_SECONDS=720
DOCUMENT_AI_IMAGE_TAG=1.0.0
OLLAMA_IMAGE=ollama/ollama:0.34.4
